{
  "name": "doc-from-usage",
  "version": "1.0.0",
  "description": "Documate — record your product, get documentation (Screenpipe + LLM)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "doc-from-usage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/server.ts src/pipeline.ts --format esm --dts --clean --out-dir dist",
    "start": "node dist/cli.js",
    "generate": "node dist/cli.js",
    "ui": "npx tsx src/server.ts",
    "record": "node dist/cli.js record",
    "record:stop": "node dist/cli.js record --stop",
    "record:kill": "pkill -f screenpipe || true",
    "record:screenpipe": "node node_modules/screenpipe/bin/screenpipe.js record"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1090.0",
    "@screenpipe/js": "file:../../packages/screenpipe-js/node-sdk",
    "archiver": "^7.0.1",
    "docx": "^9.0.0",
    "screenpipe": "latest",
    "sharp": "^0.33.5"
  }
}
